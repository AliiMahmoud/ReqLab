{
  "name": "reqlab",
  "productName": "ReqLab",
  "version": "0.1.0",
  "description": "A private, local-first API client.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "pnpm audit --prod --audit-level high && node scripts/check-osv.mjs",
    "package": "pnpm build && electron-builder",
    "package:win": "pnpm build && electron-builder --win",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:linux": "pnpm build && electron-builder --linux",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@lezer/highlight": "1.2.5",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "lit": "3.3.3",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.1.7"
  }
}
